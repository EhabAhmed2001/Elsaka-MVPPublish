@using ElsakaHerbs.ViewModels.Orders
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "الطلبات";

    var pagedResult = ViewBag.OrdersResult as OrderPagedResultViewModel ?? new();
    var orders = pagedResult.Orders;
    var stats = ViewBag.Stats as OrderStatisticsViewModel ?? new();
    var statuses = ViewBag.Statuses as List<OrderStatusViewModel> ?? new();

    var currentPhone = ViewBag.Phone as string ?? "";
    var currentOrderNumber = ViewBag.OrderNumber as string ?? "";
    var currentStatusId = ViewBag.StatusId as int?;
    var currentPageSize = ViewBag.PageSize as int? ?? 10;
}

<section class="page-section active" id="page-orders">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>الطلبات</h2>
            <p class="text-muted small mb-0">إدارة ومتابعة طلبات العملاء وحالات الشحن مع البحث والفرز.</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4" id="orderStatsGrid">
        <div class="col-6 col-lg-3">
            <div class="card stat-card shadow-sm border-0 rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">إجمالي الطلبات</span>
                        <h3 class="fw-bold mb-0 text-dark">@stats.TotalOrders</h3>
                    </div>
                    <div class="stat-icon-wrap bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card shadow-sm border-0 rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">طلبات جديدة</span>
                        <h3 class="fw-bold mb-0 text-primary">@stats.NewOrders</h3>
                    </div>
                    <div class="stat-icon-wrap bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-bell-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card shadow-sm border-0 rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">تم الشحن</span>
                        <h3 class="fw-bold mb-0 text-warning">@stats.ShippedOrders</h3>
                    </div>
                    <div class="stat-icon-wrap bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card shadow-sm border-0 rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">تم التسليم</span>
                        <h3 class="fw-bold mb-0 text-success">@stats.DeliveredOrders</h3>
                    </div>
                    <div class="stat-icon-wrap bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filters Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-controller="Dashboard" asp-action="Orders" class="row g-3 align-items-end" id="ordersFilterForm">
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-bold" for="filterPhone">رقم هاتف العميل</label>
                    <input type="text" class="form-control form-control-sm" id="filterPhone" name="phone" value="@currentPhone" placeholder="بحث برقم الهاتف...">
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-bold" for="filterOrderNumber">رقم الطلب</label>
                    <input type="text" class="form-control form-control-sm" id="filterOrderNumber" name="orderNumber" value="@currentOrderNumber" placeholder="مثال: ORD-1001">
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small fw-bold" for="filterStatus">حالة الطلب</label>
                    <select class="form-select form-select-sm" id="filterStatus" name="statusId">
                        <option value="">كل الحالات</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s.Id" selected="@(currentStatusId == s.Id ? "selected" : null)">@s.StatusName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small fw-bold" for="filterPageSize">عدد النتائج بالصفحة</label>
                    <select class="form-select form-select-sm" id="filterPageSize" name="pageSize">
                        <option value="5" selected="@(currentPageSize == 5 ? "selected" : null)">5 طلبات</option>
                        <option value="10" selected="@(currentPageSize == 10 ? "selected" : null)">10 طلبات</option>
                        <option value="20" selected="@(currentPageSize == 20 ? "selected" : null)">20 طلب</option>
                        <option value="50" selected="@(currentPageSize == 50 ? "selected" : null)">50 طلب</option>
                        <option value="100" selected="@(currentPageSize == 100 ? "selected" : null)">100 طلب</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-search"></i>
                        <span>بحث</span>
                    </button>
                    <a asp-controller="Dashboard" asp-action="Orders" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1" title="إعادة ضبط الفلاتر">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 100px;">رقم الطلب</th>
                        <th style="min-width: 150px;">العميل</th>
                        <th>الهاتف</th>
                        <th>المحافظة</th>
                        <th>التاريخ</th>
                        <th>الأصناف</th>
                        <th>الإجمالي</th>
                        <th>الحالة</th>
                        <th class="text-center">التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (orders.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                <p class="mb-0">لا توجد طلبات مطابقة لمعايير البحث الحالية.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var ord in orders)
                    {
                        <tr id="order-row-@ord.Id">
                            <td><strong>@ord.OrderNumber</strong></td>
                            <td>@ord.CustomerFullName</td>
                            <td>@ord.CustomerPhone</td>
                            <td>@ord.GovernorateName</td>
                            <td>@ord.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td>@ord.ItemsCount</td>
                            <td><strong class="text-success">@ord.GrandTotal.ToString("N0") ج.م</strong></td>
                            <td>
                                <span class="badge" style="background-color: @ord.OrderStatusColor; color: #fff;">
                                    @ord.OrderStatusName
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary btn-view-order" data-id="@ord.Id" title="عرض التفاصيل وتحديث الحالة">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (pagedResult.TotalCount > 0)
        {
            <div class="card-footer bg-white border-top d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
                <div class="text-muted small">
                    عرض <strong>@(((pagedResult.PageNumber - 1) * pagedResult.PageSize) + 1)</strong> إلى 
                    <strong>@(Math.Min(pagedResult.PageNumber * pagedResult.PageSize, pagedResult.TotalCount))</strong> 
                    من إجمالي <strong>@pagedResult.TotalCount</strong> طلب
                </div>

                @if (pagedResult.TotalPages > 1)
                {
                    <nav aria-label="تنقل صفحات الطلبات">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- Previous Page -->
                            <li class="page-item @(pagedResult.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-controller="Dashboard"
                                   asp-action="Orders"
                                   asp-route-page="@(pagedResult.PageNumber - 1)"
                                   asp-route-pageSize="@currentPageSize"
                                   asp-route-phone="@currentPhone"
                                   asp-route-orderNumber="@currentOrderNumber"
                                   asp-route-statusId="@currentStatusId"
                                   aria-label="السابق">
                                    <span aria-hidden="true">&laquo; السابق</span>
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            @{
                                var startPage = Math.Max(1, pagedResult.PageNumber - 2);
                                var endPage = Math.Min(pagedResult.TotalPages, pagedResult.PageNumber + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-controller="Dashboard"
                                       asp-action="Orders"
                                       asp-route-page="1"
                                       asp-route-pageSize="@currentPageSize"
                                       asp-route-phone="@currentPhone"
                                       asp-route-orderNumber="@currentOrderNumber"
                                       asp-route-statusId="@currentStatusId">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            @for (var p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == pagedResult.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-controller="Dashboard"
                                       asp-action="Orders"
                                       asp-route-page="@p"
                                       asp-route-pageSize="@currentPageSize"
                                       asp-route-phone="@currentPhone"
                                       asp-route-orderNumber="@currentOrderNumber"
                                       asp-route-statusId="@currentStatusId">@p</a>
                                </li>
                            }

                            @if (endPage < pagedResult.TotalPages)
                            {
                                @if (endPage < pagedResult.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-controller="Dashboard"
                                       asp-action="Orders"
                                       asp-route-page="@pagedResult.TotalPages"
                                       asp-route-pageSize="@currentPageSize"
                                       asp-route-phone="@currentPhone"
                                       asp-route-orderNumber="@currentOrderNumber"
                                       asp-route-statusId="@currentStatusId">@pagedResult.TotalPages</a>
                                </li>
                            }

                            <!-- Next Page -->
                            <li class="page-item @(pagedResult.HasNextPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-controller="Dashboard"
                                   asp-action="Orders"
                                   asp-route-page="@(pagedResult.PageNumber + 1)"
                                   asp-route-pageSize="@currentPageSize"
                                   asp-route-phone="@currentPhone"
                                   asp-route-orderNumber="@currentOrderNumber"
                                   asp-route-statusId="@currentStatusId"
                                   aria-label="التالي">
                                    <span aria-hidden="true">التالي &raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</section>

<!-- Order Details Modal -->
<div class="modal fade" id="orderModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تفاصيل الطلب <span id="modalOrderNumber"></span></h5>
                <button class="btn-close me-0 ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="orderModalBody">
                <!-- Populated via JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                <button type="button" class="btn btn-success" id="btnSaveOrderStatus">حفظ الحالة الجديدة</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const orderModal = new bootstrap.Modal(document.getElementById("orderModal"));
            let currentViewingOrderId = null;

            // View Order Details
            document.querySelectorAll(".btn-view-order").forEach(btn => {
                btn.addEventListener("click", async function () {
                    const id = this.getAttribute("data-id");
                    currentViewingOrderId = id;
                    try {
                        const res = await fetch(`/dashboard/orders/detail/${id}`);
                        const data = await res.json();
                        if (data.success && data.order) {
                            const o = data.order;
                            const statusesList = data.statuses || [];

                            document.getElementById("modalOrderNumber").textContent = "#" + o.orderNumber;
                            let itemsHtml = o.items.map(i => `
                                <tr>
                                    <td><strong>${i.packageNameSnapshot}</strong></td>
                                    <td class="text-center">${i.unitPriceSnapshot} ج.م</td>
                                    <td class="text-center">${i.quantity}</td>
                                    <td class="text-end fw-bold text-success">${i.lineTotal} ج.م</td>
                                </tr>
                            `).join("");

                            let statusOptionsHtml = statusesList.map(s => `
                                <option value="${s.id}" ${o.orderStatusId === s.id ? "selected" : ""}>${s.statusName}</option>
                            `).join("");

                            document.getElementById("orderModalBody").innerHTML = `
                                <div class="row g-3 bg-light p-3 rounded mb-3">
                                    <div class="col-sm-6"><small class="text-muted d-block">العميل:</small><strong>${o.customerFullName}</strong></div>
                                    <div class="col-sm-6"><small class="text-muted d-block">الهاتف:</small><strong dir="ltr">${o.customerPhone}</strong></div>
                                    <div class="col-sm-6"><small class="text-muted d-block">المحافظة:</small><strong>${o.governorateNameSnapshot}</strong></div>
                                    <div class="col-sm-6"><small class="text-muted d-block">العنوان:</small><strong>${o.address}</strong></div>
                                    ${o.notes ? `<div class="col-12"><small class="text-muted d-block">ملاحظات:</small><span>${o.notes}</span></div>` : ""}
                                </div>
                                <h6 class="fw-bold mb-2">أصناف الطلب:</h6>
                                <table class="table table-bordered align-middle mb-3">
                                    <thead class="table-light"><tr><th>الصنف</th><th class="text-center">سعر الوحدة</th><th class="text-center">الكمية</th><th class="text-end">الإجمالي</th></tr></thead>
                                    <tbody>${itemsHtml}</tbody>
                                    <tfoot>
                                        <tr><td colspan="3">إجمالي المنتجات</td><td class="text-end fw-bold">${o.subtotal} ج.م</td></tr>
                                        <tr><td colspan="3">مصاريف الشحن</td><td class="text-end fw-bold">${o.shippingCost} ج.م</td></tr>
                                        <tr class="table-active"><td colspan="3" class="fw-bold">الإجمالي النهائي</td><td class="text-end fw-bold text-success fs-5">${o.grandTotal} ج.م</td></tr>
                                    </tfoot>
                                </table>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">حالة الطلب:</label>
                                    <select class="form-select" id="orderStatusSelect">
                                        ${statusOptionsHtml}
                                    </select>
                                </div>
                            `;
                            orderModal.show();
                        }
                    } catch {
                        alert("تعذر جلب تفاصيل الطلب");
                    }
                });
            });

            // Save Order Status
            document.getElementById("btnSaveOrderStatus")?.addEventListener("click", async function () {
                if (!currentViewingOrderId) return;
                const statusId = parseInt(document.getElementById("orderStatusSelect").value);
                try {
                    const res = await fetch("/dashboard/orders/status", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ orderId: parseInt(currentViewingOrderId), newStatusId: statusId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        alert("تم تحديث حالة الطلب بنجاح");
                        location.reload();
                    } else {
                        alert(data.message || "تعذر تحديث الحالة");
                    }
                } catch {
                    alert("تعذر الاتصال بالخادم");
                }
            });
        });
    </script>
}
