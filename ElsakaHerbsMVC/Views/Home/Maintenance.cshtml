@model ElsakaHerbs.ViewModels.SiteContent.SiteContentViewModel
@{
    Layout = null;
    var whatsApp = Model?.WhatsAppNumber ?? "201000000000";
    var cleanWhatsApp = whatsApp.Replace("+", "").Replace(" ", "");
    var message = string.IsNullOrWhiteSpace(Model?.MaintenanceMessage)
        ? "الموقع يخضع حالياً لبعض أعمال الصيانة والتحسينات الدورية لتقديم أفضل تجربة لكم. سنعود للعمل قريباً جداً، شكراً لتفهمكم وصبركم!"
        : Model.MaintenanceMessage;
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>الموقع قيد الصيانة - السقا للأعشاب الهندية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/maintenance.css" asp-append-version="true">
</head>
<body>
    <div class="maintenance-card">
        <div>
            <img src="~/assets/LOGO.png" alt="السقا للأعشاب الهندية" class="logo-img">
        </div>

        <div class="icon-circle">
            <i class="bi bi-tools"></i>
        </div>

        <h1 class="maintenance-title">الموقع قيد الصيانة مؤقتاً</h1>

        <p class="maintenance-desc">@message</p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a class="btn-wa" href="https://wa.me/@cleanWhatsApp" target="_blank" rel="noopener">
                <i class="bi bi-whatsapp fs-5"></i>
                <span>تواصل معنا عبر واتساب</span>
            </a>
        </div>

        <div class="footer-note d-flex justify-content-between align-items-center">
            <span>جميع الحقوق محفوظة &copy; السقا للأعشاب الهندية</span>
        </div>
    </div>
</body>
</html>
