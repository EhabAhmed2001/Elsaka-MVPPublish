@using ElsakaHerbs.ViewModels.Dashboard
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Content";
    var summary = ViewBag.Summary as DashboardSummaryViewModel ?? new();
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - لوحة التحكم | السقا للأعشاب الهندية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <input id="sidebarToggle" type="checkbox" hidden>
    <div class="app-shell">
        <label class="sidebar-backdrop" id="sidebarBackdrop" for="sidebarToggle" aria-label="إغلاق القائمة"></label>

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="brand-mark">
                    <img src="~/assets/LOGO.png" alt="Logo">
                </div>
                <label class="sidebar-close d-lg-none" id="closeSidebar" for="sidebarToggle" role="button" aria-label="إغلاق">
                    <i class="bi bi-x-lg"></i>
                </label>
            </div>
            <div class="side-label">القائمة الرئيسية</div>
            <nav class="side-nav">
                <a class="nav-link @(currentAction.Equals("Content", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Content">
                    <i class="bi bi-window-sidebar"></i>
                    <span>محتوى الصفحة الرئيسية</span>
                </a>
                <a class="nav-link @(currentAction.Equals("Packages", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Packages">
                    <i class="bi bi-box-seam"></i>
                    <span>العبوات</span>
                    <span class="nav-count" id="badgePackages">@summary.PackagesCount</span>
                </a>
                <a class="nav-link @(currentAction.Equals("Orders", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Orders">
                    <i class="bi bi-receipt"></i>
                    <span>الطلبات</span>
                    @if (summary.NewOrdersCount > 0)
                    {
                        <span class="nav-count alert-count" id="badgeOrders">@summary.NewOrdersCount</span>
                    }
                    else
                    {
                        <span class="nav-count" id="badgeOrders">@summary.TotalOrdersCount</span>
                    }
                </a>
                <a class="nav-link @(currentAction.Equals("Reviews", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Reviews">
                    <i class="bi bi-chat-square-heart"></i>
                    <span>آراء العملاء</span>
                    <span class="nav-count" id="badgeReviews">@summary.ReviewsCount</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <a class="nav-link logout-link" href="" role="button">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>تسجيل الخروج</span>
                </a>
            </div>
        </aside>

        <!-- Main Area -->
        <main class="main-area">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <label class="icon-btn menu-toggle d-lg-none" id="openSidebar" for="sidebarToggle" role="button" aria-label="فتح القائمة">
                        <i class="bi bi-list"></i>
                    </label>
                    <div>
                        <h1 id="pageTitle">@(ViewData["Title"] ?? "مساحة الإدارة")</h1>
                    </div>
                </div>
                <div class="top-actions">
                    <a class="view-site" href="/" target="_blank">
                        <i class="bi bi-box-arrow-up-left"></i>
                        <span>فتح الموقع</span>
                    </a>
                    <div class="admin-profile">
                        <div class="avatar">م</div>
                        <div class="profile-copy">
                            <strong>مدير المتجر</strong>
                        </div>
                    </div>
                </div>
            </header>

            <div class="page-wrap p-3 p-md-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const toggle = document.getElementById("sidebarToggle");
            if (toggle) {
                // Auto-close sidebar on mobile when navigating via nav link
                document.querySelectorAll(".side-nav .nav-link").forEach(link => {
                    link.addEventListener("click", () => {
                        if (window.innerWidth < 992) {
                            toggle.checked = false;
                        }
                    });
                });
                // Close sidebar on Escape key
                document.addEventListener("keydown", (e) => {
                    if (e.key === "Escape" && toggle.checked) {
                        toggle.checked = false;
                    }
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
