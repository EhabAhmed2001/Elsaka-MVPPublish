@using ElsakaHerbs.interfaces
@using ElsakaHerbs.ViewModels.SiteContent
@inject ISiteContentService SiteContentService
@{
    var siteContent = ViewBag.SiteContent as SiteContentViewModel ?? await SiteContentService.GetSiteContentAsync();
    var whatsApp = siteContent?.WhatsAppNumber ?? "201000000000";
    var cleanWhatsApp = whatsApp.Replace("+", "").Replace(" ", "");
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - السقا للأعشاب الهندية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg site-navbar sticky-top" aria-label="القائمة الرئيسية">
        <div class="container">
            <a class="navbar-brand brand" href="/#home">
                <span class="brand-mark">
                    <img src="~/assets/LOGO.png" alt="السقا للأعشاب الهندية">
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="فتح القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-3 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/#home">الرئيسية</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#about">عن المنتج</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#ingredients">المكونات</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#usage">طريقة الاستخدام</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#reviews">آراء العملاء</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#packages">العبوات</a></li>
                </ul>

                <div class="nav-actions d-flex align-items-center gap-2">
                    <button class="cart-nav-btn" id="cartToggle" type="button" aria-label="فتح سلة المشتريات"
                            aria-controls="cartDrawer" aria-expanded="false">
                        <i class="bi bi-bag"></i>
                        <span>السلة</span>
                        <b id="cartBadge" class="cart-badge" aria-live="polite">0</b>
                    </button>

                    <a class="btn btn-main nav-cta" href="/#packages">اطلب الآن <i class="bi bi-arrow-left"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <a class="brand footer-brand" href="/#home">
                        <span class="brand-mark-footer">
                            <img src="~/assets/LOGO.png" alt="السقا للأعشاب الهندية">
                        </span>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <h4>روابط سريعة</h4>
                    <div class="footer-links">
                        <a href="/#about">عن المنتج</a>
                        <a href="/#ingredients">المكونات</a>
                        <a href="/#usage">طريقة الاستخدام</a>
                        <a href="/#packages">العبوات</a>
                        <a href="/dashboard">لوحة التحكم</a>
                    </div>
                </div>
                <div class="col-6 col-lg-4">
                    <h4>تواصل معنا</h4>
                    <div class="footer-links">
                        <a href="https://wa.me/@cleanWhatsApp" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp"></i>
                            واتساب: <span dir="ltr">@whatsApp</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span> جميع الحقوق محفوظة &copy; @DateTime.UtcNow.Year .</span>
            </div>
        </div>
    </footer>

    <!-- Back to top -->
    <button class="back-to-top" id="backToTop" aria-label="العودة للأعلى">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- Floating WhatsApp -->
    <a class="whatsapp-float" href="https://wa.me/@cleanWhatsApp" target="_blank" rel="noopener"
       aria-label="تواصل معنا عبر واتساب">
        <i class="bi bi-whatsapp"></i>
        <span class="whatsapp-tooltip">تواصل معنا على واتساب</span>
    </a>

    <!-- Cart Drawer -->
    <div class="cart-overlay" id="cartOverlay" hidden></div>
    <aside class="cart-drawer" id="cartDrawer" aria-label="سلة المشتريات" aria-hidden="true">
        <div class="cart-header">
            <div>
                <h2>سلة المشتريات</h2>
            </div>
            <button class="cart-close" id="cartClose" type="button" aria-label="إغلاق السلة">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="cart-items" id="cartItems" aria-live="polite"></div>
        <div class="cart-footer" id="cartFooter">
            <div class="cart-total-row"><span>الإجمالي</span><strong id="cartTotal">0 ج.م</strong></div>
            <p>الدفع نقدًا عند الاستلام</p>
            <a class="btn btn-main w-100" id="checkoutButton" href="/Checkout">إتمام الطلب <i class="bi bi-arrow-left"></i></a>
        </div>
    </aside>

    <!-- Review Modal -->
    <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content review-modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title ms-0 me-auto">رأي أحد العملاء</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <div id="reviewModalBody"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
